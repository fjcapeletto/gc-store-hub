<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GabrielCapelettoStore.Hub.ViewModels"
        xmlns:identity="using:GabrielCapelettoStore.Hub.Identity"
        xmlns:controls="using:GabrielCapelettoStore.Hub.Controls"
        xmlns:sys="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="GabrielCapelettoStore.Hub.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/gcstore.ico"
        Width="560" Height="624"
        MinWidth="520" MinHeight="520"
        Background="{StaticResource BoardGradientBrush}"
        Title="Gabriel Capeletto Store">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SilkDimBrush}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource SilkBrush}" />
        </Style>

        <Style Selector="Button.pill">
            <Setter Property="Background" Value="#22B0894F" />
            <Setter Property="BorderBrush" Value="#73B0894F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource LedAmberBrush}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="16,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#38B0894F" />
            <Setter Property="BorderBrush" Value="#A0B0894F" />
        </Style>
        <Style Selector="Button.pill:disabled">
            <Setter Property="Opacity" Value="0.38" />
        </Style>

        <!-- Locked apps: the sales hook replaces the install pill. -->
        <Style Selector="Button.unlock">
            <Setter Property="Background" Value="{StaticResource LedAmberBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#221706" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="14,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.unlock:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F6D08F" />
        </Style>
        <Style Selector="Button.unlock:disabled">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0E1712" />
            <Setter Property="Foreground" Value="{StaticResource SilkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BoardBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="260" />
        </Style>

        <Style Selector="Border.legH">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource CopperMetalBrush}" />
        </Style>
        <Style Selector="Border.legV">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource CopperMetalBrush}" />
        </Style>

        <!-- Online LED breathes; the board is live. -->
        <Style Selector="Border.ledPulse">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Panel>

        <!-- Board vignette: pool of light in the centre, darkened edges (depth). -->
        <Border Background="{StaticResource BoardVignetteBrush}" IsHitTestVisible="False" ZIndex="-2" />

        <!-- ================= CATALOG ================= -->
        <Grid IsVisible="{Binding ShowMainArea}" RowDefinitions="Auto,Auto,*" Margin="24,20">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StoreName}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource SilkBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="your device's software store" FontSize="12"
                                   Foreground="{StaticResource SilkMutedBrush}"
                                   FontFamily="Cascadia Mono,Consolas,monospace" />
                        <TextBlock Text="{Binding HubVersion}" FontSize="12"
                                   Foreground="{StaticResource CopperBrush}"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   ToolTip.Tip="Installed hub version" />
                    </StackPanel>
                    <TextBlock Text="{Binding OfflineNotice}" IsVisible="{Binding ShowOfflineNotice}"
                               FontSize="12" Foreground="{StaticResource LedAmberBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <!-- Self-update chip: shows while downloading; becomes a Restart button when ready. -->
                        <Button Classes="unlock" Content="{Binding UpdateStatusText}"
                                IsVisible="{Binding ShowUpdate}" IsEnabled="{Binding IsUpdateReady}"
                                Command="{Binding RestartUpdateCommand}" FontSize="11" Padding="12,3"
                                ToolTip.Tip="Restart to apply the update" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Classes="icon" Command="{Binding SyncCommand}" IsEnabled="{Binding !IsRefreshing}"
                                ToolTip.Tip="Check for updates" Content="⟳" />
                        <!-- Board LED: green = online, red = offline -->
                        <Panel Width="30" VerticalAlignment="Center" ToolTip.Tip="{Binding ConnectivityLabel}">
                            <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource LedGreenBrush}"
                                    Classes="ledPulse" BoxShadow="0 0 8 0 #8027E08A" IsVisible="{Binding IsOnline}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource LedRedBrush}"
                                    BoxShadow="0 0 8 0 #80E24B4A" IsVisible="{Binding !IsOnline}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                        <Button Classes="icon" Command="{Binding OpenAccessCommand}"
                                ToolTip.Tip="Store access &amp; licensing" Content="🔑" />
                        <Button Classes="icon" Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Settings" Content="⚙" />
                    </StackPanel>

                    <!-- Transient status (sync / install result) — its own line, never competes with the title. -->
                    <TextBlock Text="{Binding SyncStatus}" IsVisible="{Binding HasSyncStatus}"
                               FontSize="12" Foreground="{StaticResource SilkMutedBrush}"
                               HorizontalAlignment="Right" MaxWidth="240"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SyncStatus}" />
                </StackPanel>
            </Grid>

            <!-- Session greeting -->
            <Border Grid.Row="1" IsVisible="{Binding HasNews}"
                    Margin="0,0,0,14" Padding="12,8" CornerRadius="8"
                    Background="#14231A" BorderBrush="#2E5A3E" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{Binding NewsSummary, StringFormat='✦  {0} since your last visit'}"
                               FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SilkBrush}" />
                    <Button Grid.Column="1" Classes="icon" Command="{Binding DismissBannerCommand}"
                            ToolTip.Tip="Dismiss" FontSize="13" Content="✕" />
                </Grid>
            </Border>

            <!-- Content states -->
            <Panel Grid.Row="2">

                <StackPanel IsVisible="{Binding IsLoading}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="220" />
                    <TextBlock Text="Loading catalog…" HorizontalAlignment="Center"
                               Foreground="{StaticResource SilkMutedBrush}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasError}" MaxWidth="440"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="Store unavailable" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource SilkBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{StaticResource SilkMutedBrush}" />
                    <Button Classes="pill" Content="Try again" Command="{Binding SyncCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel IsVisible="{Binding ShowEmptyState}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="The board is bare — for now."
                               FontSize="16" Foreground="{StaticResource SilkDimBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="New chips will appear here automatically."
                               FontSize="12" Foreground="{StaticResource SilkMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>

                <Grid IsVisible="{Binding ShowCatalog}" RowDefinitions="*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Classes="icon" Content="‹" FontSize="24"
                                Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanPrevPage}"
                                IsVisible="{Binding HasMultiplePages}" VerticalAlignment="Center" />

                        <Carousel Grid.Column="1" x:Name="ShelfPager" ItemsSource="{Binding Pages}"
                                  SelectedIndex="{Binding CurrentPageIndex, Mode=TwoWay}"
                                  VerticalAlignment="Top" HorizontalAlignment="Center"
                                  PointerWheelChanged="ShelfPager_PointerWheelChanged">
                            <Carousel.PageTransition>
                                <PageSlide Duration="0:0:0.22" Orientation="Horizontal" />
                            </Carousel.PageTransition>
                            <Carousel.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShelfPageViewModel">
                                    <Grid HorizontalAlignment="Center">
                                        <controls:ChipTraceOverlay ItemCount="{Binding Items.Count}" ZIndex="-1"
                                                                   IsHitTestVisible="False"
                                                                   Width="{Binding #PageItems.Bounds.Width}"
                                                                   Height="{Binding #PageItems.Bounds.Height}" />
                                        <ItemsControl x:Name="PageItems" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShelfItemViewModel">
                                <Border Width="150" Height="148" Margin="0" Padding="6,8" CornerRadius="12">
                                    <Panel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Button Classes="tileIcon" Command="{Binding IconActionCommand}"
                                                IsEnabled="{Binding IconEnabled}" Background="Transparent"
                                                BorderThickness="0" Padding="0" HorizontalAlignment="Center">
                                            <Button.Styles>
                                                <Style Selector="Button.tileIcon"><Setter Property="Cursor" Value="Hand" /></Style>
                                                <Style Selector="Button.tileIcon:disabled"><Setter Property="Cursor" Value="Arrow" /></Style>
                                                <Style Selector="Button.tileIcon /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                                <Style Selector="Button.tileIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="Button.tileIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="Button.tileIcon Border.hoverLabel">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Setter Property="Transitions">
                                                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions>
                                                    </Setter>
                                                </Style>
                                                <Style Selector="Button.tileIcon:pointerover Border.hoverLabel">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Style>
                                            </Button.Styles>
                                        <Panel Width="110" Height="104">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Opacity="{Binding IdentityOpacity}"
                                                  RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,Auto,Auto">
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                                            HorizontalAlignment="Center" Margin="0,0,0,-3">
                                                    <Border Classes="legV" /><Border Classes="legV" /><Border Classes="legV" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="9"
                                                            VerticalAlignment="Center" Margin="0,0,-3,0">
                                                    <Border Classes="legH" /><Border Classes="legH" /><Border Classes="legH" />
                                                </StackPanel>
                                                <Border Grid.Row="1" Grid.Column="1" Width="72" Height="72" CornerRadius="15"
                                                        Background="{StaticResource ChipCapBrush}" BorderBrush="#3C5044"
                                                        BorderThickness="1.5" BoxShadow="0 5 12 0 #7A000000" Padding="4">
                                                    <Panel>
                                                        <Border Width="60" Height="60" CornerRadius="11"
                                                                Background="{StaticResource DieGlowBrush}"
                                                                BorderBrush="{StaticResource CopperDimBrush}" BorderThickness="1">
                                                            <Panel>
                                                                <!-- Publisher-supplied mark (iconUrl); falls back to the glyph below. -->
                                                                <Border IsVisible="{Binding HasIcon}" Width="48" Height="48"
                                                                        CornerRadius="9" ClipToBounds="True"
                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Image Source="{Binding Icon}" Stretch="Uniform"
                                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                                </Border>
                                                                <Path IsVisible="{Binding !HasIcon}"
                                                                      Data="{Binding App.Icon, Converter={StaticResource AppGlyph}}"
                                                                      Fill="{Binding Id, Converter={StaticResource AppAccent}}"
                                                                      Stretch="Uniform" Width="34" Height="34"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Panel>
                                                        </Border>
                                                        <Border VerticalAlignment="Top" Height="3" Margin="10,1,10,0"
                                                                CornerRadius="2" Background="#26FFFFFF" />
                                                        <Ellipse Width="4" Height="4" Fill="{StaticResource CopperBrush}"
                                                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0" />
                                                    </Panel>
                                                </Border>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="9"
                                                            VerticalAlignment="Center" Margin="-3,0,0,0">
                                                    <Border Classes="legH" /><Border Classes="legH" /><Border Classes="legH" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="9"
                                                            HorizontalAlignment="Center" Margin="0,-3,0,0">
                                                    <Border Classes="legV" /><Border Classes="legV" /><Border Classes="legV" />
                                                </StackPanel>
                                            </Grid>
                                            <Border IsVisible="{Binding IsNew}" Background="{StaticResource BadgeNewBrush}"
                                                    CornerRadius="6" Padding="5,1" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Margin="0,0,4,0">
                                                <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource BadgeNewTextBrush}" />
                                            </Border>
                                            <Border IsVisible="{Binding IsUpdated}" Background="{StaticResource BadgeUpdateBrush}"
                                                    CornerRadius="6" Padding="5,1" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Margin="0,0,4,0">
                                                <TextBlock Text="UPD" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource BadgeUpdateTextBrush}" />
                                            </Border>

                                            <!-- Locked: bright padlock over the dimmed chip. -->
                                            <Viewbox Width="30" Height="30" IsVisible="{Binding IsLocked}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Panel Width="28" Height="28">
                                                    <Ellipse Width="28" Height="28" Fill="#99000000" />
                                                    <Path Data="M9,13 V9.5 A5,5 0 0 1 19,9.5 V13"
                                                          Stroke="{StaticResource LedAmberBrush}" StrokeThickness="2.2"
                                                          StrokeLineCap="Round" />
                                                    <Path Data="M7.5,13 H20.5 A1.5,1.5 0 0 1 22,14.5 V21 A1.5,1.5 0 0 1 20.5,22.5 H7.5 A1.5,1.5 0 0 1 6,21 V14.5 A1.5,1.5 0 0 1 7.5,13 Z"
                                                          Fill="{StaticResource LedAmberBrush}" />
                                                    <Ellipse Width="3" Height="3" Fill="#221706"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Margin="0,3,0,0" />
                                                </Panel>
                                            </Viewbox>

                                            <!-- Hover: the icon is the primary affordance; reveal the verb on pointer over. -->
                                            <Border Classes="hoverLabel" Width="72" Height="72" CornerRadius="15"
                                                    Background="#DA0F1712" IsHitTestVisible="False"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding IconHoverText}" Foreground="{StaticResource SilkBrush}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Panel>
                                        </Button>

                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource SilkBrush}"
                                                   Opacity="{Binding IdentityOpacity}"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0" MaxWidth="130"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Settings gear, top-left (badges live top-right, so no clash). -->
                                    <Button IsVisible="{Binding ShowSettingsGear}" Command="{Binding OpenSettingsCommand}"
                                            Content="⚙" FontSize="16" Foreground="{StaticResource SilkMutedBrush}"
                                            Background="Transparent" BorderThickness="0" Padding="2" Margin="20,6,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand"
                                            ToolTip.Tip="Settings">
                                        <Button.Styles>
                                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    </Panel>
                                                </Border>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </Carousel.ItemTemplate>
                        </Carousel>

                        <Button Grid.Column="2" Classes="icon" Content="›" FontSize="24"
                                Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"
                                IsVisible="{Binding HasMultiplePages}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Page dots (phone-style): click to jump; wheel / arrows also turn pages. -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PageDots}" IsVisible="{Binding HasMultiplePages}"
                                  HorizontalAlignment="Center" Margin="0,10,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageDotViewModel">
                                <Button Command="{Binding GoCommand}" Width="14" Height="14" Padding="0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip.Tip="Go to page">
                                    <Button.Styles>
                                        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Button.Styles>
                                    <Panel>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SilkMutedBrush}" Opacity="0.45" />
                                        <Ellipse Width="9" Height="9" Fill="{StaticResource LedGreenBrush}"
                                                 IsVisible="{Binding IsActive}" />
                                    </Panel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </Panel>
        </Grid>

        <!-- ================= ACCESS / LICENSING ================= -->
        <Grid IsVisible="{Binding ShowAccess}" RowDefinitions="Auto,*" Margin="24,20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                <Button Classes="icon" Command="{Binding CloseAccessCommand}" Content="←" ToolTip.Tip="Back" />
                <TextBlock Text="Store access" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource SilkBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="14" MaxWidth="470" HorizontalAlignment="Left">

                    <Border Background="{StaticResource BoardPanelBrush}" BorderBrush="{StaticResource BoardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="This device" FontSize="12" Foreground="{StaticResource SilkMutedBrush}" />
                            <TextBlock Text="{Binding DeviceId}" FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="13" Foreground="{StaticResource SilkBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasLicense}" Background="{StaticResource BoardPanelBrush}"
                            BorderBrush="{StaticResource BoardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <TextBlock Text="This device is licensed. Your access syncs automatically."
                                   Foreground="{StaticResource LedGreenBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border IsVisible="{Binding !HasLicense}" Background="{StaticResource BoardPanelBrush}"
                            BorderBrush="{StaticResource BoardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Request store access" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SilkBrush}" />

                            <StackPanel IsVisible="{Binding IsAccessPending}" Spacing="4">
                                <TextBlock Text="Access requested — awaiting approval."
                                           Foreground="{StaticResource LedAmberBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="We'll email your license key once it's approved." FontSize="12"
                                           Foreground="{StaticResource SilkMutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding !IsAccessPending}" Spacing="8">
                                <TextBox Watermark="Full name" Text="{Binding AccessName}" />
                                <TextBox Watermark="Email" Text="{Binding AccessEmail}" />
                                <TextBox Watermark="Phone (optional)" Text="{Binding AccessPhone}" />
                                <Button Classes="unlock" Content="Request access"
                                        Command="{Binding RequestAccessCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding !HasLicense}" Background="{StaticResource BoardPanelBrush}"
                            BorderBrush="{StaticResource BoardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Have a license key?" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SilkBrush}" />
                            <TextBlock Text="Paste the key from your approval email." FontSize="12"
                                       Foreground="{StaticResource SilkMutedBrush}" />
                            <TextBox Watermark="License key" Text="{Binding LicenseKeyInput}"
                                     FontFamily="Cascadia Mono,Consolas,monospace" />
                            <Button Classes="pill" Content="Activate"
                                    Command="{Binding ActivateLicenseCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <TextBlock IsVisible="{Binding HasAccessMessage}" Text="{Binding AccessMessage}"
                               Foreground="{StaticResource SilkDimBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= INBOX (web app deals) ================= -->
        <Grid IsVisible="{Binding ShowInbox}" RowDefinitions="Auto,Auto,*" Margin="24,20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <Button Classes="icon" Command="{Binding CloseInboxCommand}" Content="←" ToolTip.Tip="Back" />

                <!-- The web app's own icon (publisher mark → glyph fallback), same as its shelf tile. -->
                <Border Width="30" Height="30" CornerRadius="7" VerticalAlignment="Center"
                        Background="{StaticResource DieGlowBrush}" BorderBrush="{StaticResource CopperDimBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <Panel>
                        <Image Source="{Binding InboxIcon}" IsVisible="{Binding InboxHasIcon}"
                               Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Path IsVisible="{Binding !InboxHasIcon}"
                              Data="{Binding InboxGlyphKey, Converter={StaticResource AppGlyph}}"
                              Fill="{StaticResource SilkBrush}" Stretch="Uniform" Width="18" Height="18"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Border>

                <TextBlock Text="{Binding InboxTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource SilkBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Tabs: Unread / Read -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                    <Button Content="{Binding UnreadCount, StringFormat='Unread ({0})'}"
                            Command="{Binding ShowUnreadTabCommand}" Background="Transparent" BorderThickness="0"
                            Padding="2,0" Cursor="Hand" Foreground="{StaticResource SilkBrush}" FontWeight="SemiBold">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Border Height="2" CornerRadius="1" Background="{StaticResource LedGreenBrush}"
                            IsVisible="{Binding ShowingUnread}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <Button Content="{Binding ReadCount, StringFormat='Read ({0})'}"
                            Command="{Binding ShowReadTabCommand}" Background="Transparent" BorderThickness="0"
                            Padding="2,0" Cursor="Hand" Foreground="{StaticResource SilkMutedBrush}" FontWeight="SemiBold">
                        <Button.Styles>
                            <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Border Height="2" CornerRadius="1" Background="{StaticResource LedGreenBrush}"
                            IsVisible="{Binding InboxShowRead}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CurrentInboxItems}" MaxWidth="580" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InboxItemViewModel">
                            <Button Classes="inboxRow" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch"
                                    Background="{StaticResource BoardPanelBrush}" BorderBrush="{StaticResource BoardBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                    ToolTip.Tip="{Binding Url}">
                                <Button.Styles>
                                    <Style Selector="Button.inboxRow StackPanel.rowActions">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="Transitions">
                                            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.1" /></Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button.inboxRow:pointerover StackPanel.rowActions">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="Button.rowAction /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button.rowAction:pointerover">
                                        <Setter Property="Foreground" Value="{StaticResource SilkBrush}" />
                                    </Style>
                                </Button.Styles>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Icon: link-preview thumbnail, or a web-link glyph fallback. Hover shows the time. -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                            Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="{StaticResource DieGlowBrush}"
                                            BorderBrush="{StaticResource BoardBorderBrush}" BorderThickness="1"
                                            ToolTip.Tip="{Binding TimestampLabel}">
                                        <Panel>
                                            <Image Source="{Binding Image}" IsVisible="{Binding HasImage}"
                                                   Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            <Path IsVisible="{Binding !HasImage}"
                                                  Data="M12,3 A9,9 0 1 0 12.01,3 Z M3.5,12 H20.5 M12,3 A13.5,9 0 0 0 12,21 M12,3 A13.5,9 0 0 1 12,21"
                                                  Stroke="{StaticResource SilkMutedBrush}" StrokeThickness="1.4"
                                                  Stretch="Uniform" Width="20" Height="20"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                               Foreground="{StaticResource SilkBrush}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />

                                    <!-- Hover actions: mark read/unread + delete (client-side sanitization). -->
                                    <StackPanel Grid.Column="2" Classes="rowActions" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Classes="rowAction" Content="✓" IsVisible="{Binding CanMarkRead}"
                                                Command="{Binding MarkReadCommand}" ToolTip.Tip="Mark as read"
                                                Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                Foreground="{StaticResource SilkMutedBrush}" FontSize="14" />
                                        <Button Classes="rowAction" Content="↩" IsVisible="{Binding CanMarkUnread}"
                                                Command="{Binding MarkUnreadCommand}" ToolTip.Tip="Mark as unread"
                                                Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                Foreground="{StaticResource SilkMutedBrush}" FontSize="14" />
                                        <Button Classes="rowAction" Content="✕"
                                                Command="{Binding DeleteCommand}" ToolTip.Tip="Delete"
                                                Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                                Foreground="{StaticResource SilkMutedBrush}" FontSize="14" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ================= TILE SETTINGS (web: subscription + delivery; app: status + uninstall) ========= -->
        <Grid IsVisible="{Binding ShowTileSettings}" RowDefinitions="Auto,*" Margin="24,20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
                <Button Classes="icon" Command="{Binding CloseTileSettingsCommand}" Content="←" ToolTip.Tip="Back" />

                <Border Width="30" Height="30" CornerRadius="7" VerticalAlignment="Center"
                        Background="{StaticResource DieGlowBrush}" BorderBrush="{StaticResource CopperDimBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <Panel>
                        <Image Source="{Binding SettingsIcon}" IsVisible="{Binding SettingsHasIcon}"
                               Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <Path IsVisible="{Binding !SettingsHasIcon}"
                              Data="{Binding SettingsGlyphKey, Converter={StaticResource AppGlyph}}"
                              Fill="{StaticResource SilkBrush}" Stretch="Uniform" Width="18" Height="18"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingsTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource SilkBrush}" />
                    <TextBlock Text="Settings" FontSize="11" Foreground="{StaticResource SilkMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left" Spacing="14">

                    <!-- Status + subscription / uninstall -->
                    <Border Background="{StaticResource BoardPanelBrush}" BorderBrush="{StaticResource BoardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource SilkMutedBrush}" />
                                <TextBlock Text="{Binding SettingsStatus}" Foreground="{StaticResource SilkBrush}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Classes="pill" Content="Subscribe" IsVisible="{Binding ShowSubscribeButton}"
                                        Command="{Binding SubscribeFromSettingsCommand}" />
                                <Button Content="Unsubscribe" IsVisible="{Binding ShowUnsubscribeButton}"
                                        Command="{Binding UnsubscribeFromSettingsCommand}" Background="Transparent"
                                        BorderThickness="1" BorderBrush="{StaticResource BoardBorderBrush}"
                                        Foreground="{StaticResource SilkMutedBrush}" Padding="12,6" CornerRadius="6" />
                                <Button Content="Uninstall" IsVisible="{Binding SettingsCanUninstall}"
                                        Command="{Binding UninstallFromSettingsCommand}" Background="Transparent"
                                        BorderThickness="1" BorderBrush="{StaticResource BoardBorderBrush}"
                                        Foreground="{StaticResource SilkMutedBrush}" Padding="12,6" CornerRadius="6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Delivery (web, subscribed only) -->
                    <StackPanel Spacing="10" IsVisible="{Binding ShowDeliverySection}">
                        <TextBlock Text="How should new deals reach you?" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource SilkBrush}" />

                        <ItemsControl ItemsSource="{Binding WebConfigOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WebDeliveryOptionViewModel">
                                    <Button Command="{Binding SelectCommand}" HorizontalAlignment="Stretch"
                                            Background="{StaticResource BoardPanelBrush}" BorderThickness="1.5"
                                            CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="BorderBrush" Value="{StaticResource BoardBorderBrush}" />
                                            </Style>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{StaticResource BoardPanelBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8" Margin="0,2,12,0"
                                                    VerticalAlignment="Top" BorderThickness="1.5"
                                                    BorderBrush="{StaticResource CopperDimBrush}">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource LedGreenBrush}"
                                                         IsVisible="{Binding IsSelected}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource SilkBrush}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           Foreground="{StaticResource SilkMutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border IsVisible="{Binding ShowCadence}" Width="340" HorizontalAlignment="Left"
                                Background="{StaticResource BoardPanelBrush}" BorderBrush="{StaticResource BoardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                                    <TextBlock Text="Time between pop-ups" Foreground="{StaticResource SilkBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WebConfigIntervalLabel}" Foreground="{StaticResource LedGreenBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Slider Minimum="{Binding CadenceMin}" Maximum="{Binding CadenceMax}"
                                        Value="{Binding WebConfigIntervalSeconds, Mode=TwoWay}"
                                        TickFrequency="30" IsSnapToTickEnabled="True" />
                                <Grid ColumnDefinitions="*,*">
                                    <TextBlock Grid.Column="0" Text="30 s" FontSize="11"
                                               Foreground="{StaticResource SilkMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="1 h" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{StaticResource SilkMutedBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Classes="pill" Content="Save delivery" Command="{Binding SaveDeliveryConfigCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= SETTINGS ================= -->
        <Grid IsVisible="{Binding ShowSettings}" RowDefinitions="Auto,*" Margin="24,20">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                <Button Classes="icon" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Back" Content="←" />
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource SilkBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="12" MaxWidth="620" HorizontalAlignment="Left">

                    <Border CornerRadius="10" Background="{StaticResource BoardPanelBrush}"
                            BorderThickness="1" BorderBrush="{StaticResource BoardBorderBrush}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding DeviceIdentity.VerdictHeadline}"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SilkBrush}" />
                            <TextBlock Text="{Binding DeviceIdentity.VerdictDetail}"
                                       Foreground="{StaticResource SilkDimBrush}" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DeviceIdentity.Anomalies}"
                                  IsVisible="{Binding DeviceIdentity.HasAnomalies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource LedAmberBrush}"
                                           TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="This device" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{StaticResource SilkBrush}" />

                    <Border CornerRadius="10" Background="{StaticResource BoardPanelBrush}"
                            BorderThickness="1" BorderBrush="{StaticResource BoardBorderBrush}" Padding="4,8">
                        <ItemsControl ItemsSource="{Binding DeviceIdentity.Signals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="identity:SignalRow">
                                    <Grid ColumnDefinitions="190,*,Auto" Margin="12,6">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontSize="13" Foreground="{StaticResource SilkMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}"
                                                             FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                                             Foreground="{StaticResource SilkBrush}"
                                                             FontFamily="Cascadia Mono,Consolas,monospace" />
                                        <Border Grid.Column="2" IsVisible="{Binding !IsDistinctive}"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Background="#2EB0894F" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="shared default" FontSize="10"
                                                       Foreground="{StaticResource LedAmberBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SilkMutedBrush}"
                               Text="These are the hardware signals used to recognize this device. They are readable by any local tool — none is a secret, and none is your license key." />

                    <Button Classes="pill" Content="Copy diagnostics" Click="OnCopyDiagnostics" HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding DeviceIdentity.DiagnosticsLine}"
                               IsVisible="{Binding DeviceIdentity.ShowDiagnostics}"
                               FontSize="11" Foreground="{StaticResource SilkMutedBrush}" TextWrapping="Wrap"
                               FontFamily="Cascadia Mono,Consolas,monospace" Margin="0,8,0,0" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Panel>

</Window>
