<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GabrielCapelettoStore.Hub.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="GabrielCapelettoStore.Hub.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        MinWidth="640" MinHeight="420"
        Title="Gabriel Capeletto Store">

    <Design.DataContext>
        <!-- Design-time only; real DataContext is set in App.axaml.cs -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StoreName}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Your device's software store" FontSize="13" Opacity="0.55" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Checking…" IsVisible="{Binding IsRefreshing}"
                           FontSize="12" Opacity="0.5" VerticalAlignment="Center" />
                <!-- Discrete sync icon: manual, instant check for updates -->
                <Button Command="{Binding SyncCommand}" IsEnabled="{Binding !IsRefreshing}"
                        ToolTip.Tip="Check for updates"
                        Background="Transparent" BorderThickness="0" Padding="6"
                        FontSize="18" Content="⟳" />
            </StackPanel>
        </Grid>

        <!-- Session greeting: what changed since the last visit; dismissible -->
        <Border Grid.Row="1" IsVisible="{Binding HasNews}"
                Margin="0,0,0,14" Padding="12,8" CornerRadius="6"
                Background="#1F4CAF50" BorderBrush="#664CAF50" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding NewsSummary, StringFormat='✨  {0} since your last visit'}"
                           FontSize="13" FontWeight="SemiBold" />
                <Button Grid.Column="1" Command="{Binding DismissBannerCommand}"
                        ToolTip.Tip="Dismiss"
                        Background="Transparent" BorderThickness="0" Padding="6,2"
                        FontSize="13" Content="✕" />
            </Grid>
        </Border>

        <!-- Content: exactly one state is visible at a time -->
        <Panel Grid.Row="2">

            <!-- Loading (first load only) -->
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="220" />
                <TextBlock Text="Loading catalog…" HorizontalAlignment="Center" Opacity="0.6" />
            </StackPanel>

            <!-- Error (with retry) -->
            <StackPanel IsVisible="{Binding HasError}" MaxWidth="440"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <TextBlock Text="Store unavailable" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           TextAlignment="Center" Opacity="0.6" />
                <Button Content="Try again" Command="{Binding SyncCommand}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Empty shelves -->
            <StackPanel IsVisible="{Binding ShowEmptyState}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="The shelves are empty — for now."
                           FontSize="16" Opacity="0.6" HorizontalAlignment="Center" />
                <TextBlock Text="New apps will appear here automatically."
                           FontSize="12" Opacity="0.4" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Catalog -->
            <ScrollViewer IsVisible="{Binding ShowCatalog}">
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShelfItemViewModel">
                            <Border Margin="0,0,0,10" Padding="16" CornerRadius="8"
                                    Background="#11808080"
                                    BorderThickness="1" BorderBrush="#33808080">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" FontSize="16"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <!-- NEW badge (green) — only for not-installed apps -->
                                            <Border IsVisible="{Binding IsNew}" VerticalAlignment="Center"
                                                    Background="#2E7D32" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="NEW" FontSize="10" FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                            <!-- UPDATE badge (blue) — only for installed apps with a newer version -->
                                            <Border IsVisible="{Binding IsUpdated}" VerticalAlignment="Center"
                                                    Background="#1565C0" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="UPDATE" FontSize="10" FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                   FontSize="13" Opacity="0.7" />
                                        <TextBlock Text="{Binding VersionSubline}" FontSize="12" Opacity="0.55" />
                                        <Border HorizontalAlignment="Left" CornerRadius="4"
                                                Padding="6,2" Background="#22808080">
                                            <TextBlock Text="{Binding IdentityMode}" FontSize="11" Opacity="0.7" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" MinWidth="92"
                                            Content="{Binding InstallButtonText}"
                                            Command="{Binding InstallCommand}"
                                            IsEnabled="{Binding CanInstall}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Panel>
    </Grid>

</Window>
