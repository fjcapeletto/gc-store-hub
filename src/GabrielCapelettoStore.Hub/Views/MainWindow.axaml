<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GabrielCapelettoStore.Hub.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GabrielCapelettoStore.Hub.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="600"
        MinWidth="640" MinHeight="420"
        Title="Gabriel Capeletto Store">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Empty-hub-first walking skeleton: no real catalog yet, just the shell. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="{Binding StoreName}"
                   FontSize="30" FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding EmptyStateMessage}"
                   FontSize="16" Opacity="0.6"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding StatusLine}"
                   FontSize="12" Opacity="0.4"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center" />
    </StackPanel>

</Window>
